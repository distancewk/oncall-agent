# Copy to .env and replace every placeholder before running docker compose.
DASHSCOPE_API_KEY=replace-with-dashscope-key
APP_API_TOKEN=replace-with-long-random-api-token
APP_ADMIN_TOKEN=replace-with-different-admin-api-token
APP_WEBHOOK_SECRET=replace-with-long-random-webhook-secret
APP_WEBHOOK_SIGNING_SECRET=replace-with-different-webhook-signing-secret
# Optional rotation overlap, newest secret first, comma-separated.
APP_WEBHOOK_SIGNING_SECRETS=
APP_SECURITY_SESSION_SIGNING_SECRET=replace-with-different-session-signing-secret
# Optional short-lived machine token support; production requires an independent secret and Redis.
APP_SECURITY_MACHINE_TOKEN_ENABLED=false
APP_SECURITY_MACHINE_TOKEN_SIGNING_SECRET=replace-with-different-machine-token-secret
APP_SECURITY_MACHINE_TOKEN_SIGNING_SECRETS=
APP_SECURITY_MACHINE_TOKEN_REQUIRE_REDIS=false
APP_SECURITY_DEFAULT_TENANT_ID=default
APP_SECURITY_OIDC_ENABLED=false
APP_SECURITY_OIDC_ISSUER_URI=
APP_SECURITY_OIDC_CLIENT_ID=
APP_SECURITY_OIDC_CLIENT_SECRET=
APP_SECURITY_OIDC_REDIRECT_URI={baseUrl}/login/oauth2/code/enterprise
APP_SECURITY_OIDC_REGISTRATION_ID=enterprise
APP_SECURITY_OIDC_SCOPES=openid,profile,email
APP_SECURITY_OIDC_TENANT_CLAIM=tenant_id
APP_SECURITY_OIDC_GROUPS_CLAIM=groups
APP_SECURITY_OIDC_ADMIN_GROUP=ADMIN
APP_SECURITY_OIDC_OPERATOR_GROUP=OPERATOR
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_COOKIE_SAME_SITE=lax
APP_MODEL_NAME=qwen3-max
APP_MODEL_USAGE_ENABLED=true
# Optional estimated prices per 1,000 tokens; leave at 0 when provider billing is not configured.
APP_MODEL_COST_CURRENCY=CNY
APP_MODEL_INPUT_COST_PER_1K_TOKENS=0
APP_MODEL_OUTPUT_COST_PER_1K_TOKENS=0
APP_TRACE_EXPORT_ENABLED=false
APP_TRACE_EXPORT_ENDPOINT=
APP_TRACE_EXPORT_API_KEY=
APP_TRACE_SERVICE_NAME=superbizagent
APP_TRACE_EXPORT_SAMPLING_PROBABILITY=0.1
APP_TRACE_EXPORT_TIMEOUT_MILLIS=1000
APP_TRACE_EXPORT_MAX_PENDING=100
APP_DEPENDENCY_PROBES_ENABLED=true
APP_DEPENDENCY_PROBE_TIMEOUT_MILLIS=2000
PROMETHEUS_API_KEY=
CLS_API_KEY=
CLS_PROBE_PATH=/
CLS_NATIVE_SIGNING_ENABLED=false
CLS_SECRET_ID=
CLS_SECRET_KEY=
CLS_REGION=ap-guangzhou
CLS_SERVICE=cls
CLS_PROBE_TOPIC_ID=
DASHSCOPE_PROBE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_PROBE_PATH=/deployments/models?page_no=1&page_size=1&version=v1.0&model_source=base
APP_WEBHOOK_REPLAY_REQUIRE_REDIS=false
APP_LIFECYCLE_ENABLED=false
APP_LIFECYCLE_TERMINAL_JOB_RETENTION_DAYS=0
APP_LIFECYCLE_INDEX_TASK_RETENTION_DAYS=0
APP_LIFECYCLE_CHAT_SESSION_RETENTION_DAYS=0
APP_LIFECYCLE_SECURITY_AUDIT_RETENTION_DAYS=365
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
APP_INCIDENT_JDBC_PASSWORD=replace-with-long-random-postgres-password
MINIO_ROOT_USER=replace-with-minio-user
MINIO_ROOT_PASSWORD=replace-with-long-random-minio-password
